# Copie para .env e ajuste os valores locais.
# Em Docker Compose, use os hosts de serviço (mysql, redis, maylove-storages).
#
# Railway (serviço maylove-api → Variables → Add Reference):
#   DATABASE_URL=${{MySQL.MYSQL_PRIVATE_URL}}
#   REDIS_URL=${{Redis.REDIS_PRIVATE_URL}}
#   MESSENGER_TRANSPORT_DSN=${{Redis.REDIS_PRIVATE_URL}}/messages
# Acrescente ?serverVersion=8.0&charset=utf8mb4 na DATABASE_URL se faltar.

APP_ENV=dev
APP_SECRET=change-me-in-production
DEFAULT_URI=http://localhost:8080

DATABASE_URL=mysql://maylove:secret@mysql:3306/maylove?serverVersion=8.0&charset=utf8mb4
REDIS_URL=redis://redis:6379
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages

APP_URL=http://localhost:5173
STORAGE_API_URL=http://maylove-storages:8081
STORAGE_PUBLIC_URL=http://localhost:8081
STORAGE_SERVICE_TOKEN_SECRET=change-me-shared-secret

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_API_BASE=https://api.mercadopago.com
MERCADOPAGO_WEBHOOK_SIGNATURE_REQUIRED=true

AUTH_TOKEN_SALT=change-me-use-at-least-32-characters-long
AUTH_TOKEN_HEADER_NAME=x-maylove-token
AUTH_SESSION_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_SLIDING_RENEWAL_MINUTES=30
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_EMAIL_VERIFICATION_HOURS=24
AUTH_COOKIE_SECURE=false

# Resend (port Glow: RESEND_APITOKEN + Mensageria:Email:From)
MAIL_ENABLED=false
MAIL_FROM="MayLove <noreply@maylove.com.br>"
# Produção: MAILER_DSN=resend+api://re_sua_api_key@default
MAILER_DSN=null://null

CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
