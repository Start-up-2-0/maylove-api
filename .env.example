# MayLove API — Template de variáveis de ambiente
# Copiar para .env e preencher os valores reais.

APP_ENV=dev
APP_SECRET=CHANGE_ME_TO_RANDOM_64_CHARS
APP_EXPOSE_ERRORS=true
DEFAULT_URI=http://localhost:8080

DATABASE_URL=mysql://root:root@127.0.0.1:3306/maylove?serverVersion=8.0&charset=utf8mb4

APP_URL=http://localhost:5173
CORS_ALLOW_ORIGIN=^https?://localhost(:[0-9]+)?$

# Proxy reverso (Railway/prod): use REMOTE_ADDR ou 127.0.0.1,REMOTE_ADDR
# TRUSTED_PROXIES=127.0.0.1

STORAGE_API_URL=http://localhost:8081
STORAGE_PUBLIC_URL=http://localhost:8081
STORAGE_SERVICE_TOKEN_SECRET=CHANGE_ME_MIN_32_CHARS

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_API_BASE=https://api.mercadopago.com
MERCADOPAGO_WEBHOOK_SIGNATURE_REQUIRED=false

BILLING_ENABLED=false

AUTH_TOKEN_SALT=CHANGE_ME_MIN_32_CHARS_RANDOM
AUTH_TOKEN_HEADER_NAME=x-maylove-token
AUTH_SESSION_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_SLIDING_RENEWAL_MINUTES=30
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_COOKIE_SECURE=false

AUTH_EMAIL_VERIFICATION_ENABLED=false
AUTH_EMAIL_VERIFICATION_HOURS=24

MAIL_ENABLED=false
MAIL_FROM="MayLove <noreply@maylove.com.br>"
MAILER_DSN=null://null
